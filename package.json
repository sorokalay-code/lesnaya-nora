{
  "name": "lesnaya-nora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "tsx tools/run-tests.ts",
    "format": "prettier --write src tests tools vite.config.ts tsconfig*.json package.json",
    "format:check": "prettier --check src tests tools vite.config.ts tsconfig*.json package.json",
    "check:structure": "tsx tools/check-structure.ts",
    "audit:models": "tsx tools/audit-models.ts",
    "audit:scene": "tsx tools/audit-scene.ts",
    "models": "tsx tools/build-models.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm run typecheck && vite build && pnpm run check:deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "check:deploy": "tsx tools/check-deploy.ts",
    "check": "pnpm run format:check && pnpm run check:structure && pnpm test && pnpm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.6.0"
  }
}
